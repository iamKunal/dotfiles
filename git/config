[init]
	defaultBranch = main
[http]
	postBuffer = 524288000


[includeIf "gitdir:~/Documents/work/peerdb/"]
  path = configs/peerdb.config

[includeIf "gitdir:~/Documents/work/clickhouse/"]
  path = configs/clickhouse.config


[url "ssh://git@github.com/clickhouse/"]
  insteadOf = https://github.com/clickhouse/

[core]
	autocrlf = false
  pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
  line-numbers = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
